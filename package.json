{
  "name": "photo-video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "render:still": "node scripts/render.mjs still",
    "render:intro": "node scripts/render.mjs video",
    "build:travel": "esbuild scripts/build-travel.ts --bundle --platform=node --format=esm --external:sharp --outfile=.cache/build-travel.mjs --log-level=error && node .cache/build-travel.mjs",
    "fetch:data": "node scripts/fetch-data.mjs",
    "build:ingest": "node tools/build-ingest.mjs",
    "desktop": "node desktop/build.mjs && electron desktop",
    "desktop:build": "node desktop/build.mjs",
    "desktop:dist": "node desktop/build.mjs && cd desktop && npm install --omit=dev --no-audit --no-fund && cd .. && electron-builder --config electron-builder.config.mjs",
    "desktop:size": "node desktop/report-size.mjs"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/noto-serif-kr": "^5.3.1",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/pretendard": "^5.3.0",
    "@remotion/bundler": "4.0.542",
    "@remotion/player": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "d3-geo": "^3.1.2",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "libheif-js": "^1.23.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.542",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "description": "사진과 메타데이터로 업무용 영상을 만드는 스튜디오(웹·데스크톱)"
}
